# ==============================================================================
# Rels Laundry - Environment Configuration Template (.env.example)
# Safe for Version Control (No actual production secrets included)
# Copy to .env for local usage: cp .env.example .env
# ==============================================================================

# Server Network & Runtime
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Service Meta
APP_NAME="Rels Laundry Cloud — Smart Laundry POS & WhatsApp Bot Platform"
SERVICE_VERSION="1.0.0"

# Database Configuration (Multi-Tier)
DB_TYPE=sqlite
DB_PATH=/app/data/laundry.db

# PostgreSQL Settings (Docker Multi-Tier)
DB_HOST=db
DB_PORT=5432
POSTGRES_USER=rels_user
POSTGRES_PASSWORD=rels_secure_password_2026
POSTGRES_DB=rels_laundry_db

# Redis Caching Layer (Bonus +5 Poin)
REDIS_HOST=cache
REDIS_PORT=6379

# Adminer Port (Tools Profile)
ADMINER_PORT=8080
